@model PrjFinanceiro.Models.Doacao

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Excluir Doação</h2>
        </div>

        <div class="card-body">
            <h4 class="text-danger">
                Tem certeza que deseja excluir esta doação?
            </h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">ID da Doação:</dt>
                <dd class="col-sm-9">@Model.IdDoacao</dd>

                <dt class="col-sm-3">Data da Doação:</dt>
                <dd class="col-sm-9">@Model.DataDoacao</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">ID do Animal:</dt>
                <dd class="col-sm-9">@Model.IdAnimal</dd>

                <dt class="col-sm-3">ID da Pessoa:</dt>
                <dd class="col-sm-9">@Model.IdPessoa</dd>

            </dl>

            <form action="/Doacao/ExcluirConfirmado" method="post">

                <input type="hidden"
                       name="codigo"
                       value="@Model.IdDoacao" />

                <button type="submit" class="btn btn-danger">
                    Sim, Excluir
                </button>

                <a href="/Doacao/Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>
        </div>
    </div>
</div>