@model PrjFinanceiro.Models.Voluntario

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Excluir Voluntário</h2>
        </div>

        <div class="card-body">
            <h4 class="text-danger">
                Tem certeza que deseja excluir este voluntário?
            </h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">ID do Voluntário:</dt>
                <dd class="col-sm-9">@Model.Idvoluntario</dd>

                <dt class="col-sm-3">Nome:</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Telefone:</dt>
                <dd class="col-sm-9">@Model.Telefone</dd>

                <dt class="col-sm-3">Disponibilidade:</dt>
                <dd class="col-sm-9">@Model.Disponibilidade</dd>

                <dt class="col-sm-3">E-mail:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

            </dl>

            <form action="/Voluntario/ExcluirConfirmado" method="post">

                <input type="hidden"
                       name="idVoluntario"
                       value="@Model.Idvoluntario" />

                <button type="submit" class="btn btn-danger">
                    Sim, Excluir
                </button>

                <a href="/Voluntario/Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>
        </div>
    </div>
</div>