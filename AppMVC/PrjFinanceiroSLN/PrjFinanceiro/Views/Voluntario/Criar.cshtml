@model PrjFinanceiro.Models.Voluntario

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Novo Voluntário</h2>
        </div>
        <div class="card-body">
            <form action="/Voluntario/Criar" method="post">

                <div class="form-group mb-3">
                    <label for="nome">Nome do Voluntário</label>
                    <input type="text" id="nome" name="nome" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="Telefone">Telefone</label>
                    <input type="text" id="telefone" name="telefone" class="form-control" maxlength="20" required  />
                </div>

                <div class="form-group mb-3">
                    <label for="Disponibilidade">Disponibilidade</label>
                    <input type="text" id="disponibilidade" name="disponibilidade" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="Email">E-mail</label>
                    <input type="text" id="email" name="email" class="form-control" maxlength="100" required />
                </div>
                <div class="form-group mb-3">
                    <label for="Idvoluntario">Id do Voluntario</label>
                    <input type="text" id="Idvoluntario" name="Idvoluntario" class="form-control" maxlength="20" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Voluntário </button>
                    <a href="/Voluntario/Index" class="btn btn-secondary">Voltar para a Lista</a>
                </div>



            </form>
        </div>
    </div>
</div>