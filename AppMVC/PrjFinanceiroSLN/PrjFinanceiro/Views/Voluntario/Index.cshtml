@model IEnumerable<PrjFinanceiro.Models.Voluntario>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Voluntários - @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Voluntario/Criar" class="btn btn-success">Cadastrar Novo Voluntário</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Id do Voluntário</th>
                <th>Disponibilidade</th>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Telefone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>                    
                    <td>@item.Idvoluntario</td>
                    <td>@item.Disponibilidade</td>
                    <td>@item.Nome</td>
                    <td>@item.Email</td>
                    <td>@item.Telefone</td>
                    <td>
                        <a href="/Voluntario/Editar/@item.Idvoluntario" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Voluntario/Excluir/@item.Idvoluntario" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>