@model IEnumerable<PrjFinanceiro.Models.Animal>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Animais -  @ViewBag.animais disponiveis</h2>

    <p>
        <a href="/Animal/Criar" class="btn btn-success">Cadastrar Novo Animal</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Idanimal</th>
                <th>Nome do Animal</th>
                <th>Sexo</th>
                <th>Status</th>
                <th>Porte</th>
                <th>Raca</th>
                <th>Dataresgate</th>
                <th>Idade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.\IdAnimal">                    
                    <td>@item.IdAnimal</td>
                    <td>@item.Nome</td>
                    <td>@item.Sexo</td>
                    <td>@item.Status</td>
                    <td>@item.Porte</td>
                    <td>@item.Raça</td>
                    <td>@item.Idade</td>
                    <td>@item.Dataresgate</td>
                    <td>
                        <a href="/Agencia/Editar/@item.IdAnimal" class="btn btn-sm btn-primary">Editar</a>
                        <button type="button" class="btn btn-danger"
                                onclick="abrirModalExcluir(@item.IdAnimal, '@item.Nome')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir este animal <strong id="nomeAnimalModal"></strong>?</p>
                <input type="hidden" id="idAnimalExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>


<script>
    // Função para preparar o modal com os dados da agência selecionada
    function abrirModalExcluir(id, nome) {
        $('#idAnimalExcluir').val(id);
        $('#nomeAnimalModal').text(nome);
        $('#modalExcluir').modal('show');
    }

    // Função que envia a requisição para o C#
    function confirmarExclusao() {
        var id = $('#idAnimalExcluir').val();

        $.ajax({
            url: '/Animal/ExcluirConfirmadoModal',
            type: 'POST',
            data: { codigo: id },
            success: function (result) {
                if (result.success) {
                    // Fecha o modal
                    $('#modalExcluir').modal('hide');
                    // Remove a linha da tabela com um efeito suave
                    $('#linha-' + id).fadeOut(500, function () {
                        $(this).remove();
                    });
                } else {
                    alert(result.message);
                }
            },
            error: function () {
                alert("Erro técnico ao tentar excluir.");
            }
        });
    }
</script>